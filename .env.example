# =============================================================
# NSRFLIX Scraper — Variables de entorno requeridas
# Copia este archivo a .env y rellena los valores reales.
# =============================================================

# Master key para validar peticiones del frontend y ofuscación de URLs
NSR_MASTER_KEY=genera_una_key_secreta_aqui

# Secreto para firmar JWTs
JWT_SECRET=genera_otro_secreto_aqui

# Email del primer administrador (se aplica al iniciar la BD)
NSR_ADMIN_EMAIL=tu_email_aqui@gmail.com

# Google OAuth Client ID (opcional — deshabilita Google login si falta)
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com

# URL de conexión Postgres (Fly.io la inyecta automáticamente)
DATABASE_URL=postgresql://user:pass@host:5432/dbname
